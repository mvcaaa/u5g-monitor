{
 "title": "U5G Radio Monitor",
 "uid": "u5g-radio-monitor",
 "tags": [
  "u5g",
  "lte",
  "5g"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Скорость (активная проба Speedtest Tracker, ежечасно)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 101,
   "type": "timeseries",
   "title": "Скорость: загрузка / отдача",
   "description": "Измеренная скорость по результатам последнего теста (значение держится до следующего теста).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(speedtest_tracker_download_bits)",
     "legendFormat": "download"
    },
    {
     "refId": "B",
     "expr": "max(speedtest_tracker_upload_bits)",
     "legendFormat": "upload"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "lineWidth": 2,
      "showPoints": "always",
      "pointSize": 7,
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 102,
   "type": "timeseries",
   "title": "Задержка и джиттер пробы, мс",
   "description": "Пинг/латентность из теста Speedtest Tracker.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (__name__) ({__name__=~\"speedtest_tracker_.*(ping|latency_iqm).*_ms\"})",
     "legendFormat": "{{__name__}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "lineWidth": 2,
      "showPoints": "always",
      "pointSize": 7,
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 103,
   "type": "row",
   "title": "Путь: задержка и потери (ICMP, каждые 15 с)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   }
  },
  {
   "id": 104,
   "type": "timeseries",
   "title": "RTT до целей",
   "description": "Первая цель (адрес самого модема) — U5G, локальный участок; nopeus.dna.fi — сервер DNA Helsinki (он же сервер тестов скорости); 1.1.1.1 и 8.8.8.8 — внешний интернет.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_icmp_duration_seconds{phase=\"rtt\",job=\"blackbox_icmp\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 105,
   "type": "timeseries",
   "title": "Потери пакетов (среднее за 5 мин)",
   "description": "Доля неотвеченных ICMP-запросов. Если потери появляются у DNA и внешних целей, но не у U5G — проблема на радиоканале или в сети оператора.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg_over_time(probe_success{job=\"blackbox_icmp\"}[5m])",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 1,
   "type": "row",
   "title": "Состояние и свежесть данных",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 18
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Возраст данных модема",
   "description": "Секунды с момента last_seen устройства в контроллере. Рост без сброса = модем/контроллер перестал обновлять статистику.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - u5g_last_seen_timestamp_seconds",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 180
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Изменений SNR за 10 мин",
   "description": "0 = значение SNR не менялось 10 минут, почти наверняка данные не обновляются.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "changes(unpoller_device_mbb_snr_db[10m])",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Несущие LTE / NR",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_carriers",
     "instant": true,
     "legendFormat": "{{carrier_type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Суммарная полоса",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_bandwidth_mhz",
