         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Конфигурация во времени",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   }
  },
  {
   "id": 8,
   "type": "state-timeline",
   "title": "Радиоконфигурация: ячейка, PCI, диапазоны",
   "description": "Каждая строка — уникальная комбинация меток. Смена соты или диапазона даёт новую строку.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_info",
     "legendFormat": "cell {{cell_id}} | PCI {{pci}} | NR {{band}} | LTE EARFCN {{channel}} | {{rat}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 75,
      "lineWidth": 0
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "активно",
         "color": "green",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "never",
    "alignValue": "left",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 9,
   "type": "state-timeline",
   "title": "Агрегация несущих (Carrier Aggregation)",
   "description": "Состав CA: каждая несущая LTE и NR отдельной строкой. Источник: json_exporter (поле ca_lte / ca_nr).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
