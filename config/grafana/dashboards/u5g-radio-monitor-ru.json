    {
     "refId": "B",
     "expr": "u5g_ca_nr_present",
     "legendFormat": "NR n{{band}} ARFCN {{dl_arfcn}} primary={{primary}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 75,
      "lineWidth": 0
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "в агрегации",
         "color": "blue",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "never",
    "alignValue": "left",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 10,
