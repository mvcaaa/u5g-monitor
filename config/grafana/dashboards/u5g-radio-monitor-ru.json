        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Цели сбора",
   "description": "1 = цель доступна для Prometheus.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"unpoller|u5g_ca\"}",
     "instant": true,
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
