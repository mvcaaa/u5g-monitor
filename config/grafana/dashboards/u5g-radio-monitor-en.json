     "refId": "B",
     "expr": "u5g_watchdog_light_threshold_seconds",
     "legendFormat": "threshold"
    },
    {
     "refId": "C",
     "expr": "u5g_watchdog_light_baseline_seconds",
     "legendFormat": "baseline"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false,
      "showPoints": "always",
      "pointSize": 5,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
