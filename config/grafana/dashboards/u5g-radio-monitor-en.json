{
 "title": "U5G Radio Monitor (EN)",
 "uid": "u5g-radio-monitor-en",
 "tags": [
  "u5g",
  "lte",
  "5g"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 12,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 103,
   "type": "row",
   "title": "Path: latency and loss (ICMP, every 15 s)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   }
  },
  {
   "id": 104,
   "type": "timeseries",
   "title": "RTT to targets",
   "description": "First target (the modem's own address) - U5G local hop; nopeus.dna.fi - DNA Helsinki server (also the speed-test server); 1.1.1.1 and 8.8.8.8 - public internet.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_icmp_duration_seconds{phase=\"rtt\",job=\"blackbox_icmp\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 105,
   "type": "timeseries",
   "title": "Packet loss (5 min average)",
   "description": "Share of unanswered ICMP echo requests. If loss appears for DNA and external targets but not for the U5G, the problem is on the radio link or in the operator network.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg_over_time(probe_success{job=\"blackbox_icmp\"}[5m])",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 1,
   "type": "row",
   "title": "Status and data freshness",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 18
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Modem data age",
   "description": "Seconds since the device's last_seen in the controller. Steady growth = modem/controller stopped updating statistics.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - u5g_last_seen_timestamp_seconds",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 180
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "SNR changes in 10 min",
   "description": "0 = SNR value unchanged for 10 minutes, almost certainly stale data.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "changes(unpoller_device_mbb_snr_db[10m])",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "LTE / NR carriers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_carriers",
     "instant": true,
     "legendFormat": "{{carrier_type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Total bandwidth",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_bandwidth_mhz",
     "instant": true,
     "legendFormat": "{{direction}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Scrape targets",
   "description": "1 = target reachable by Prometheus.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"unpoller|u5g_ca\"}",
     "instant": true,
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Configuration over time",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   }
  },
  {
   "id": 8,
   "type": "state-timeline",
   "title": "Radio configuration: cell, PCI, bands",
   "description": "Each row is a unique label combination. A change of cell or band creates a new row.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_info",
     "legendFormat": "cell {{cell_id}} | PCI {{pci}} | NR {{band}} | LTE EARFCN {{channel}} | {{rat}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 75,
      "lineWidth": 0
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "active",
         "color": "green",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "never",
    "alignValue": "left",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 9,
   "type": "state-timeline",
   "title": "Carrier aggregation",
   "description": "CA composition: each LTE and NR carrier on its own row. Source: json_exporter (ca_lte / ca_nr fields).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 31
   },
   "targets": [
    {
     "refId": "A",
     "expr": "u5g_ca_lte_present",
     "legendFormat": "LTE B{{band}} EARFCN {{earfcn}} primary={{primary}}"
    },
    {
     "refId": "B",
     "expr": "u5g_ca_nr_present",
     "legendFormat": "NR n{{band}} ARFCN {{dl_arfcn}} primary={{primary}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 75,
      "lineWidth": 0
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "in aggregation",
         "color": "blue",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "never",
    "alignValue": "left",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Signal quality (5 min average)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 38
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "SNR / SINR, dB",
   "description": "Instantaneous SNR fluctuates by 2-10 dB within one cell, so a 5-minute average is shown.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 39
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(unpoller_device_mbb_snr_db[5m])",
     "legendFormat": "LTE SNR"
    },
    {
     "refId": "B",
     "expr": "avg_over_time(unpoller_device_mbb_nr_snr_db[5m])",
     "legendFormat": "NR SNR"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dB",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "RSRP, dBm",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 39
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(unpoller_device_mbb_rsrp_dbm[5m])",
     "legendFormat": "LTE RSRP"
    },
    {
     "refId": "B",
     "expr": "avg_over_time(unpoller_device_mbb_nr_rsrp_dbm[5m])",
     "legendFormat": "NR RSRP"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dBm",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "RSRQ, dB",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 47
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(unpoller_device_mbb_rsrq_db[5m])",
     "legendFormat": "LTE RSRQ"
    },
    {
     "refId": "B",
     "expr": "avg_over_time(unpoller_device_mbb_nr_rsrq_db[5m])",
     "legendFormat": "NR RSRQ"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dB",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
