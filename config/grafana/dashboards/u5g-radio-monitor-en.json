    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Maximum network bitrate (ceiling, not measured speed)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 47
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_mbb_max_bitrate_bps{direction=\"dl\"}",
     "legendFormat": "{{carrier_type}} down"
    },
    {
     "refId": "B",
     "expr": "unpoller_device_mbb_max_bitrate_bps{direction=\"ul\"}",
     "legendFormat": "{{carrier_type}} up"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 15,
   "type": "row",
   "title": "WAN load and latency (context)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 55
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "WAN traffic eth4",
   "description": "Shows link utilisation, not link quality: when idle, both graphs are low in good and bad conditions alike.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 56
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_wan_receive_rate_bytes{name=\"UXG Max\",port=\"eth4\"} * 8",
     "legendFormat": "down"
    },
    {
     "refId": "B",
     "expr": "unpoller_device_wan_transmit_rate_bytes{name=\"UXG Max\",port=\"eth4\"} * 8",
     "legendFormat": "up"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 15,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "WAN latency (gateway)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 56
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (name) (unpoller_device_uplink_latency_seconds{name=\"UXG Max\"})",
     "legendFormat": "latency"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 106,
   "type": "timeseries",
   "title": "WAN download and secondary carriers",
   "description": "Blue line - WAN download rate. 0/1 fill - whether a secondary LTE carrier (SCell) is currently active. If SCell bursts coincide with traffic bursts, this is normal carrier activation under load.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 64
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unpoller_device_wan_receive_rate_bytes{name=\"UXG Max\",port=\"eth4\"} * 8",
     "legendFormat": "WAN down"
    },
    {
     "refId": "B",
     "expr": "max(u5g_ca_lte_present{primary=\"false\"}) or vector(0)",
     "legendFormat": "secondary LTE carrier active"
    },
    {
     "refId": "C",
     "expr": "max(u5g_ca_lte_present{primary=\"false\",band=\"3\"}) or vector(0)",
     "legendFormat": "of which B3"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 15,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "secondary.*|of which.*"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.lineInterpolation",
        "value": "stepAfter"
       },
       {
        "id": "custom.fillOpacity",
        "value": 30
       },
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "custom.axisLabel",
        "value": "0 / 1"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 200,
   "type": "row",
   "title": "TrueNAS diagnostic probe (every 5 min; not used for detection)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 72
   },
   "panels": []
  },
  {
   "id": 201,
   "type": "timeseries",
   "title": "Probe speed: DNA vs Cloudflare",
   "description": "5 MB download from TrueNAS via the U5G. DNA ≪ Cloudflare means destination-dependent degradation (episode signature).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 73
   },
   "targets": [
    {
     "refId": "A",
     "expr": "u5g_probe_download_bits_per_second{target=\"dna\"}",
     "legendFormat": "DNA"
    },
    {
     "refId": "B",
     "expr": "u5g_probe_download_bits_per_second{target=\"cloudflare\"}",
     "legendFormat": "Cloudflare"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "spanNulls": false,
      "showPoints": "always",
      "pointSize": 5
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 8000000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
