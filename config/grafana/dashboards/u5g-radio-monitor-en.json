  {
   "id": 215,
   "type": "timeseries",
   "title": "Light probe: time to download 1 MB from DNA, s",
   "description": "Judged by TIME, not speed (slow start). Red dashed line = detection threshold, max(LK x baseline, LFLOOR) = max(4 x baseline, 1.5 s); baseline = median of good-state samples (~24 h). Light episode = 3 samples in a row above it, cleared after 5 in a row below. Slow state: 3.5-5 s (5 s = probe timeout).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 95
   },
