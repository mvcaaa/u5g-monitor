# Copy to .env (scripts/init.sh does it) and fill in. NEVER commit .env.
TZ=Europe/Helsinki

# --- modem (UniFi 5G Max Outdoor) ---
# management IP of the modem (required; the host must be able to reach it)
U5G_IP=
U5G_SSH_USER=admin
U5G_SSH_PORT=2222

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Telegram alerts (BotFather token, numeric chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- UniFi controller (read-only API key) ---
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=

# --- Speedtest Tracker ---
SPEEDTEST_APP_KEY=
SPEEDTEST_PORT=8080
SPEEDTEST_SCHEDULE="7 * * * *"
SPEEDTEST_SERVERS=14164,22669,14928

# --- watchdog tuning (defaults shown) ---
WD_THRESH=8000000
WD_NEED=3
WD_MIN_INTERVAL=10800
WD_MAX_PER_DAY=4
